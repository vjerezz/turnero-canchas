# Opcional en desarrollo. Solo servidor; no usar NEXT_PUBLIC_ para secretos.
APP_URL=http://localhost:3000
# Supabase de desarrollo. Copiar desde Connect; nunca usar sb_secret_ ni service_role.
# Completar solo en .env.local; no versionar los valores reales.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Mercado Pago y correo se configurarán en sus fases correspondientes.
